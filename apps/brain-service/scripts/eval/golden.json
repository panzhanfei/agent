{
  "version": 2,
  "description": "Eval：对齐 PathPlan + planFanOut（每槽 Send+FC → plan_slot_join → plan_slot_post → plan_merge）",
  "cases": [
    {
      "id": "G1",
      "tier": "pipeline",
      "label": "闲聊不检索",
      "question": "你好",
      "assert": {
        "mustNotIncludeSteps": ["plan_executor", "km_retrieve", "list_retrieve", "plan_slot_join", "plan_merge", "retrieval", "analyst"],
        "minAnswerLength": 1
      }
    },
    {
      "id": "G2",
      "tier": "pipeline",
      "label": "姓名（语料 retrieve 或 Mem0 recall）",
      "question": "我的名字",
      "assert": {
        "mustIncludeAnySteps": [["km_retrieve", "list_retrieve", "plan_slot_join", "plan_merge", "retrieval", "plan_executor", "user_fact"]],
        "minAnswerLength": 1,
        "answerRe": "潘展飞",
        "answerMustNotRe": "哪|哪个|请说明|指的是|哪一段"
      }
    },
    {
      "id": "G3",
      "tier": "pipeline",
      "label": "项目与技术",
      "question": "我做过的项目和掌握的技术",
      "assert": {
        "mustIncludeAnySteps": [["km_retrieve", "list_retrieve", "plan_slot_join", "plan_merge", "retrieval", "plan_executor"]],
        "mustIncludeSteps": ["analyst"],
        "minAnswerLength": 60
      }
    },
    {
      "id": "G4",
      "tier": "pipeline",
      "label": "城管平台技术",
      "question": "城管平台用了什么技术",
      "assert": {
        "mustIncludeAnySteps": [["km_retrieve", "list_retrieve", "plan_slot_join", "plan_merge", "retrieval", "plan_executor"]],
        "mustIncludeSteps": ["content_organizer", "analyst"],
        "answerRe": "城管|城市管理平台|React|TypeScript|UniApp|Vite"
      }
    },
    {
      "id": "G5",
      "tier": "pipeline",
      "label": "无上下文 clarify",
      "question": "那个项目呢？",
      "assert": {
        "mustIncludeSteps": ["intake"],
        "mustNotIncludeSteps": ["analyst", "plan_executor"],
        "answerRe": "哪|哪个|请说明|指的是|哪一段|哪一家|什么项目|能否说明|例如|细节|名称|领域|提供更多"
      }
    },
    {
      "id": "G5b",
      "tier": "pipeline",
      "label": "多轮指代补全（QU-02）",
      "history": [
        {
          "role": "user",
          "content": "城管平台用了什么技术"
        },
        {
          "role": "assistant",
          "content": "城市管理平台前端使用 React、TypeScript、Vite；小程序端使用 UniApp。"
        }
      ],
      "question": "那个项目呢？",
      "assert": {
        "mustIncludeAnySteps": [["km_retrieve", "list_retrieve", "plan_slot_join", "plan_merge", "retrieval", "plan_executor"]],
        "answerMustNotRe": "哪|哪个|请说明|指的是|哪一段|哪一家|什么项目|能否说明",
        "answerRe": "城管|城市管理|React|UniApp|TypeScript|Vite"
      }
    },
    {
      "id": "G5c",
      "tier": "pipeline",
      "label": "实体替换续问（入职年份 · 云联智慧 · QU-03）",
      "history": [
        {
          "role": "user",
          "content": "我那一年入职奥卡云的？"
        },
        {
          "role": "assistant",
          "content": "你于 2021 年 6 月入职西安奥卡云科技有限公司。"
        }
      ],
      "question": "云联智慧呢",
      "assert": {
        "mustIncludeAnySteps": [["km_retrieve", "list_retrieve", "plan_slot_join", "plan_merge", "retrieval", "plan_executor"]],
        "mustIncludeSteps": ["analyst"],
        "answerMustNotRe": "哪|哪个|请说明|指的是|哪一段",
        "answerRe": "2016|2017|云联智慧",
        "answerMustIncludeAll": ["云联智慧"]
      }
    },
    {
      "id": "K1",
      "tier": "km",
      "label": "姓名（Intake 改写 searchQuery）",
      "km": {
        "searchQuery": "个人简介 简历 姓名",
        "queryType": "identity",
        "topics": [],
        "subTasks": []
      },
      "assert": {
        "expectProfile": "identity",
        "expectConfidenceTier": "high",
        "minHits": 1,
        "topPathRe": "personal",
        "notTopPathRe": "projects/resume|_TEMPLATE"
      }
    },
    {
      "id": "K2",
      "tier": "km",
      "label": "姓名（identityGuard）",
      "km": {
        "searchQuery": "我的名字是什么？",
        "queryType": "identity",
        "topics": [],
        "subTasks": []
      },
      "assert": {
        "expectProfile": "identity",
        "expectConfidenceTier": "high",
        "minHits": 1,
        "topPathRe": "personal",
        "notTopPathRe": "projects/resume|_TEMPLATE",
        "excerptRe": "姓名.*潘展飞|潘展飞"
      }
    },
    {
      "id": "L3",
      "tier": "list",
      "label": "列举经历（corpus-lister 目录扫盘）",
      "list": {
        "listKind": "experience",
        "action": "preview",
        "page": 1
      },
      "assert": {
        "expectProfile": "enumeration",
        "expectConfidenceTier": "high",
        "minHits": 1,
        "minExperienceHits": 4,
        "noProjectsInHits": true,
        "notesRe": "列举分页"
      }
    },
    {
      "id": "K4",
      "tier": "km",
      "label": "项目技术",
      "km": {
        "searchQuery": "城管平台用了什么技术？",
        "queryType": "tech",
        "topics": [],
        "subTasks": []
      },
      "assert": {
        "expectProfile": "tech",
        "minHits": 1,
        "topPathRe": "urban|城管|platform|project|experience|city|management"
      }
    },
    {
      "id": "K5",
      "tier": "km",
      "label": "奥卡云经历",
      "km": {
        "searchQuery": "介绍一下西安奥卡云的工作经历",
        "queryType": "default",
        "topics": [],
        "subTasks": []
      },
      "assert": {
        "expectProfile": "default",
        "minHits": 1,
        "topPathRe": "experience|奥卡云"
      }
    },
    {
      "id": "E2E-identity",
      "tier": "pipeline",
      "label": "全链路姓名",
      "question": "我的名字是什么？",
      "assert": {
        "mustIncludeAnySteps": [["km_retrieve", "list_retrieve", "plan_slot_join", "plan_merge", "retrieval", "plan_executor", "user_fact"]],
        "answerRe": "潘展飞"
      }
    },
    {
      "id": "E2E-enumeration",
      "tier": "pipeline",
      "label": "全链路列举",
      "question": "我在哪几家公司上过班？",
      "assert": {
        "mustIncludeAnySteps": [["km_retrieve", "list_retrieve", "plan_slot_join", "plan_merge", "retrieval", "plan_executor"]],
        "mustIncludeSteps": ["analyst"],
        "answerRe": "云联智慧|友谊时光|奖多多|奥卡云"
      }
    },
    {
      "id": "E2E-dual-list",
      "tier": "pipeline",
      "label": "纯 list 双槽：项目经历 + 从业经历",
      "question": "列出项目经历和从业经历",
      "assert": {
        "mustIncludeSteps": ["list_retrieve", "analyst"],
        "mustNotIncludeSteps": ["plan_executor", "plan_merge"],
        "minAnswerLength": 80,
        "answerMustIncludeAll": ["云联智慧", "友谊时光"],
        "answerRe": "项目|城管|agents|aky|flattening|独立开源"
      }
    },
    {
      "id": "E2E-five-composite",
      "tier": "pipeline",
      "label": "五连问：姓名+年龄+记住QQ side-effect+履历list+开源链接",
      "question": "我叫什么？今年多大？我的qq是734858469，请帮我记住。列出我的履历。近两年开源项目的GitHub地址是什么？",
      "assert": {
        "mustIncludeSteps": ["plan_merge", "analyst"],
        "mustIncludeAnySteps": [["user_fact", "km_retrieve", "list_retrieve", "plan_slot_join", "plan_merge"]],
        "minAnswerLength": 40,
        "answerRe": "潘展飞",
        "answerMustIncludeAll": ["潘展飞", "734858469"],
        "answerMustNotRe": "未能生成回复|未找到与「近两年"
      }
    },
    {
      "id": "E2E-six-composite-qq-phone",
      "tier": "pipeline",
      "label": "六连问：姓名+年龄+QQ(recall)+履历+GitHub+手机（QQ 须先 remember）",
      "question": "我叫什么？今年多大？我的QQ号多少？告诉我。告诉我我的简历里面有什么（我的从业经历）。我近两年的开源项目的GitHub地址是什么？我的手机号多少？",
      "assert": {
        "mustIncludeSteps": ["plan_merge", "analyst"],
        "mustIncludeAnySteps": [["km_retrieve", "list_retrieve", "plan_slot_join", "plan_merge"]],
        "minAnswerLength": 80,
        "answerMustIncludeAll": ["潘展飞", "734858469"],
        "answerRe": "云联智慧|友谊时光|github\\.com/panzhanfei",
        "answerMustNotRe": "未能生成回复"
      }
    }
  ],
  "memProbe": {
    "id": "GMem",
    "label": "P0-16 对话 A 记 QQ → 新对话 B 问（对齐 Intake 示例 remember/recall）",
    "conversationIdPrefix": "eval-mem",
    "qq": "734858469",
    "turns": [
      {
        "conversationSuffix": "a",
        "question": "我的qq是734858469，请帮我记住",
        "assert": {
          "answerRe": "734858469",
          "mustIncludeSteps": ["user_fact"]
        }
      },
      {
        "conversationSuffix": "b",
        "question": "我的qq是多少",
        "assert": {
          "answerRe": "734858469",
          "mustIncludeSteps": ["user_fact"]
        }
      }
    ]
  },
  "cacheProbe": {
    "id": "CACHE-G4-repeat",
    "label": "同问重复（cache 探测；主路径为 planFanOut 真实步骤）",
    "conversationIdPrefix": "eval-cache",
    "turns": [
      {
        "question": "城管平台用了什么技术",
        "assert": {
          "mustIncludeAnySteps": [["km_retrieve", "list_retrieve", "plan_slot_join", "plan_merge", "retrieval", "plan_executor"]],
          "answerRe": "城管|城市管理平台|技术|React|TypeScript"
        }
      },
      {
        "question": "城管平台用了什么技术",
        "assert": {
          "mustIncludeAnySteps": [
            ["km_retrieve", "list_retrieve", "plan_slot_join", "plan_merge", "retrieval", "plan_executor", "repeat_respond_early"]
          ],
          "answerRe": "城管|城市管理平台|技术|React|TypeScript"
        },
        "expectCacheHit": true
      }
    ]
  },
